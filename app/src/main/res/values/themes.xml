<resources>
    <style name="Theme.Bpeq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="WidgetButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFE3E5EA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/widget_button_bg</item>
    </style>
    <color name="bg">#FF0E1014</color>
    <color name="icon_bg">#FF14181F</color>
    <color name="icon_fg">#FF8AB4FF</color>
</resources>
